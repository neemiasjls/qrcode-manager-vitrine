{
  "name": "qrcode-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "down": "powershell -NoProfile -ExecutionPolicy Bypass -File ./stop.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:stop": "docker compose down",
    "db:reset": "node --env-file=.env.local scripts/db-reset.mjs && npm run db:migrate && npm run db:seed",
    "seed:users": "npm run db:seed",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env.local scripts/migrate.mjs --status",
    "db:seed": "node --env-file=.env.local scripts/seed-users.mjs",
    "db:psql": "docker exec -it qrcode-manager-db psql -U postgres -d qrcode",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
