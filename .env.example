# URL pública usada para montar os links e QR codes (em dev, o start.ps1 preenche com a porta real).
NEXT_PUBLIC_BASE_URL=

# Senha do Postgres local (container do docker-compose.yml). O start.ps1 gera uma aleatória se faltar.
POSTGRES_PASSWORD=

# Connection string do Postgres. Só servidor; nunca prefixar com NEXT_PUBLIC_.
DATABASE_URL=

# Segredo que assina o cookie de sessão (mínimo 32 caracteres). O start.ps1 gera um aleatório.
SESSION_SECRET=

# Senha dos usuários de teste do seed local (opcional; sem ela o seed gera uma e mostra no terminal).
SEED_PASSWORD=
